{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "edit": "allow",
    "webfetch": "allow",
    "external_directory": "deny",
    "bash": {
      "*": "allow",
      "rm -rf *": "deny",
      "rm -r *": "deny",
      "Remove-Item *": "deny",
      "rmdir *": "deny",
      "rd *": "deny",
      "del *": "deny",
      "git push*": "deny",
      "git reset*": "deny",
      "git clean*": "deny",
      "git checkout*": "deny",
      "rustup *": "deny",
      "setx *": "deny",
      "reg *": "deny",
      "npm *": "deny",
      "npx *": "deny",
      "winget *": "deny",
      "choco *": "deny",
      "shutdown*": "deny"
    }
  }
}
