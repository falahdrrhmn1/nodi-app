// Nodi shell resources.
//
// Compiled by build.rs through `windres`. Numeric resource types are used so the
// script needs no MinGW headers on the include path:
//   1  = RT_ICON (referenced by the ICON statement)
//   14 = RT_GROUP_ICON (the ICON statement below)
//   16 = RT_VERSION (VERSIONINFO)
//   24 = RT_MANIFEST
//
// The icon is a hand-drawn 16/32/48 px, 32-bit BGRA asset (no external
// downloads); the manifest requests Common Controls v6, PerMonitorV2 DPI
// awareness and a UTF-8 active code page.

1 ICON "nodi.ico"
1 24 "nodi.manifest"

1 VERSIONINFO
FILEVERSION 0,3,0,0
PRODUCTVERSION 0,3,0,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "Nodi Mark III"
            VALUE "FileVersion", "0.3.0.0"
            VALUE "InternalName", "nodi"
            VALUE "OriginalFilename", "nodi.exe"
            VALUE "ProductName", "Nodi Mark III"
            VALUE "ProductVersion", "0.3.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
